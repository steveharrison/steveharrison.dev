---
// A small skeuomorphic document: a softly shaded sheet with a folded corner,
// a blue title line and grey body text. Gradient ids are made unique per
// instance because the icon repeats down a list.
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
const id = `doc-${Math.random().toString(36).slice(2, 8)}`;
---

<svg class:list={['document-icon', className]} width="21" height="24" viewBox="0 0 28 32" aria-hidden="true">
	<defs>
		<linearGradient id={`${id}-sheet`} x1="0" y1="0" x2="0" y2="1">
			<stop offset="0" stop-color="#ffffff" />
			<stop offset="1" stop-color="#eeeef1" />
		</linearGradient>
		<linearGradient id={`${id}-fold`} x1="0" y1="0" x2="1" y2="1">
			<stop offset="0" stop-color="#ffffff" />
			<stop offset="1" stop-color="#d9d9df" />
		</linearGradient>
		<linearGradient id={`${id}-title`} x1="0" y1="0" x2="1" y2="0">
			<stop offset="0" stop-color="#3b82f6" />
			<stop offset="1" stop-color="#60a5fa" />
		</linearGradient>
	</defs>
	<!-- Sheet -->
	<path
		d="M6 2.5h12.25L24.5 8.75V27a2.5 2.5 0 0 1-2.5 2.5H6A2.5 2.5 0 0 1 3.5 27V5A2.5 2.5 0 0 1 6 2.5Z"
		fill={`url(#${id}-sheet)`}
		stroke="#c6c6ce"
		stroke-width="0.75"
	/>
	<!-- Folded corner, with a soft shadow where it lifts off the page -->
	<path d="M18.25 2.5V7a1.75 1.75 0 0 0 1.75 1.75h4.5" fill="none" stroke="rgba(0,0,0,0.06)" stroke-width="2" />
	<path
		d="M18.25 2.5V7a1.75 1.75 0 0 0 1.75 1.75h4.5Z"
		fill={`url(#${id}-fold)`}
		stroke="#c6c6ce"
		stroke-width="0.75"
		stroke-linejoin="round"
	/>
	<!-- Title and body text -->
	<rect x="7.5" y="10.5" width="9" height="2.25" rx="1.125" fill={`url(#${id}-title)`} />
	<rect x="7.5" y="15.5" width="13" height="1.5" rx="0.75" fill="#c9c9d1" />
	<rect x="7.5" y="19" width="13" height="1.5" rx="0.75" fill="#c9c9d1" />
	<rect x="7.5" y="22.5" width="8.5" height="1.5" rx="0.75" fill="#c9c9d1" />
</svg>

<style>
	.document-icon {
		flex-shrink: 0;
		filter: drop-shadow(0 1px 1.5px rgba(0, 0, 0, 0.12));
	}
</style>
