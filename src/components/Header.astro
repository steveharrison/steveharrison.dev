---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
import YouTubeIcon from '../assets/icons/youtube.svg';
import XIcon from '../assets/icons/x.svg';
import LinkedInIcon from '../assets/icons/linkedin.svg';
import GitHubIcon from '../assets/icons/github.svg';
import StackOverflowIcon from '../assets/icons/stackoverflow.svg';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="nav-right">
			<div class="nav-links">
				<HeaderLink href="/">Home</HeaderLink>
				<HeaderLink href="/articles">Blog</HeaderLink>
				<HeaderLink href="/recommendations">Recommendations</HeaderLink>
			</div>
			<div class="social-links">
				<a href="https://www.youtube.com/@steve_harrison" target="_blank">
					<span class="sr-only">Follow Steve on YouTube</span>
					<YouTubeIcon width={20} height={20} aria-hidden="true" />
				</a>
				<a href="https://x.com/stevenaharrison" target="_blank">
					<span class="sr-only">Follow Steve on X</span>
					<XIcon width={20} height={20} aria-hidden="true" />
				</a>
				<a href="https://www.linkedin.com/in/stevenanthonyharrison/" target="_blank">
					<span class="sr-only">Go to Steve's LinkedIn profile</span>
					<LinkedInIcon width={20} height={20} aria-hidden="true" />
				</a>
				<a href="https://github.com/steveharrison" target="_blank">
					<span class="sr-only">Go to Steve's GitHub repo</span>
					<GitHubIcon width={20} height={20} aria-hidden="true" />
				</a>
				<a href="https://stackoverflow.com/users/48492/steve-harrison" target="_blank">
					<span class="sr-only">Go to Steve's StackOverflow profile</span>
					<StackOverflowIcon width={20} height={20} aria-hidden="true" />
				</a>
			</div>
		</div>
		<button class="menutrigger" id="hamburger-btn" aria-label="Menu" aria-expanded="false">
			<svg class="menutrigger-icon" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
				<polyline
					id="menutrigger-top"
					class="menutrigger-bread"
					fill="none"
					stroke="currentColor"
					stroke-width="1.2"
					stroke-linecap="round"
					stroke-linejoin="round"
					points="2 5, 16 5"
				>
					<animate
						id="menutrigger-top-open"
						attributeName="points"
						keyTimes="0;0.5;1"
						dur="0.24s"
						begin="indefinite"
						fill="freeze"
						calcMode="spline"
						keySplines="0.42, 0, 1, 1;0, 0, 0.58, 1"
						values="2 5, 16 5;2 9, 16 9;3.5 3.5, 15 15"
					></animate>
					<animate
						id="menutrigger-top-close"
						attributeName="points"
						keyTimes="0;0.5;1"
						dur="0.24s"
						begin="indefinite"
						fill="freeze"
						calcMode="spline"
						keySplines="0.42, 0, 1, 1;0, 0, 0.58, 1"
						values="3.5 3.5, 15 15;2 9, 16 9;2 5, 16 5"
					></animate>
				</polyline>
				<polyline
					id="menutrigger-bottom"
					class="menutrigger-bread"
					fill="none"
					stroke="currentColor"
					stroke-width="1.2"
					stroke-linecap="round"
					stroke-linejoin="round"
					points="2 12, 16 12"
				>
					<animate
						id="menutrigger-bottom-open"
						attributeName="points"
						keyTimes="0;0.5;1"
						dur="0.24s"
						begin="indefinite"
						fill="freeze"
						calcMode="spline"
						keySplines="0.42, 0, 1, 1;0, 0, 0.58, 1"
						values="2 12, 16 12;2 9, 16 9;3.5 15, 15 3.5"
					></animate>
					<animate
						id="menutrigger-bottom-close"
						attributeName="points"
						keyTimes="0;0.5;1"
						dur="0.24s"
						begin="indefinite"
						fill="freeze"
						calcMode="spline"
						keySplines="0.42, 0, 1, 1;0, 0, 0.58, 1"
						values="3.5 15, 15 3.5;2 9, 16 9;2 12, 16 12"
					></animate>
				</polyline>
			</svg>
		</button>
	</nav>
</header>

<!-- Full-screen mobile overlay -->
<div class="overlay" id="mobile-overlay" aria-hidden="true">
	<div class="overlay-nav">
		<a href="/">Home</a>
		<a href="/articles">Blog</a>
		<a href="/recommendations">Recommendations</a>
	</div>
	<div class="overlay-social">
		<a href="https://www.youtube.com/@steve_harrison" target="_blank">YouTube</a>
		<a href="https://x.com/stevenaharrison" target="_blank">X</a>
		<a href="https://www.linkedin.com/in/stevenanthonyharrison/" target="_blank">LinkedIn</a>
		<a href="https://github.com/steveharrison" target="_blank">GitHub</a>
		<a href="https://stackoverflow.com/users/48492/steve-harrison" target="_blank">Stack Overflow</a>
	</div>
</div>

<style>
	/* ---- Header bar ---- */
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		border-bottom: 1px solid rgb(var(--grey-light));
		position: sticky;
		top: 0;
		z-index: 1001;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	
	nav {
		padding: 10px 0;
	}

	nav a {
		padding-top: 10px;
		padding-bottom: 2px;
		color: var(--black);
		text-decoration: none;
	}

	nav h2 {
		font-size: 20px;
		font-weight: 500;
	}

	.nav-right {
		display: flex;
		align-items: center;
		gap: 1em;
	}

	.nav-links, .social-links {
		display: flex;
		gap: 0.75rem;
	}
	
	.nav-links {
		margin-right: 10px;
	}

	.nav-links a, .social-links a {
		font-size: 0.95em;
		font-weight: 500;
		color: #000;
		transition: color 0.2s ease;
	}

	.nav-links a:hover,
	.social-links a:hover {
		color: var(--grey);
		border-color: var(--grey);
	}

	.social-links,
	.social-links a {
		display: flex;
	}

	/* ---- Hamburger button (Apple-style morph) ---- */
	.menutrigger {
		display: none;
		position: relative;
		z-index: 1001;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.5em;
		color: rgb(var(--grey));
		-webkit-tap-highlight-color: transparent;
	}

	.menutrigger-icon {
		display: block;
	}

	/* ---- Full-screen overlay ---- */
	.overlay {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 1000;
		background: rgba(255, 255, 255, 0.97);
		-webkit-backdrop-filter: blur(20px);
		backdrop-filter: blur(20px);
		display: flex;
		flex-direction: column;
		padding: 4em 1.5em 0;
		max-height: 0;
		overflow: hidden;
		opacity: 0;
		visibility: hidden;
		transition: max-height 0.5s cubic-bezier(0.52, 0.16, 0.24, 1), opacity 0.36s linear, visibility 0s linear 0.5s;
	}

	.overlay.is-open {
		max-height: 100vh;
		opacity: 1;
		visibility: visible;
		transition: max-height 0.5s cubic-bezier(0.52, 0.16, 0.24, 1), opacity 0.36s linear, visibility 0s;
	}

	.overlay-nav {
		display: flex;
		flex-direction: column;
		padding-top: 1em;
		border-top: 1px solid rgb(var(--grey-light));
	}

	.overlay-nav a {
		font-size: 1em;
		font-weight: 500;
		color: rgb(var(--grey));
		text-decoration: none;
		padding: 0.6em 0;
		transition: color 0.2s ease;
	}

	.overlay-nav a:hover {
		color: rgb(var(--accent));
	}

	.overlay-social {
		display: flex;
		flex-direction: column;
		gap: 0;
		padding-top: 1.5em;
	}

	.overlay-social a {
		font-size: 1em;
		font-weight: 500;
		color: rgb(var(--grey));
		text-decoration: none;
		padding: 0.6em 0;
		transition: color 0.2s ease;
	}

	.overlay-social a:hover {
		color: rgb(var(--accent));
	}

	/* ---- Responsive ---- */
	@media (max-width: 600px) {
		.nav-right {
			display: none;
		}
		.menutrigger {
			display: block;
		}
	}

	@media (min-width: 601px) {
		.menutrigger {
			display: none !important;
		}
		.overlay {
			display: none !important;
		}
	}

	@media (min-width: 601px) and (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>

<script is:inline>
	document.addEventListener('DOMContentLoaded', function () {
		var hamburger = document.getElementById('hamburger-btn');
		var overlay = document.getElementById('mobile-overlay');
		var animOpen = [
			document.getElementById('menutrigger-top-open'),
			document.getElementById('menutrigger-bottom-open')
		];
		var animClose = [
			document.getElementById('menutrigger-top-close'),
			document.getElementById('menutrigger-bottom-close')
		];

		function runAnim(anims) {
			for (var i = 0; i < anims.length; i++) {
				if (anims[i] && typeof anims[i].beginElement === 'function') {
					try { anims[i].beginElement(); } catch (e) {}
				}
			}
		}

		function openMenu() {
			overlay.classList.add('is-open');
			overlay.setAttribute('aria-hidden', 'false');
			document.body.style.overflow = 'hidden';
			hamburger.setAttribute('aria-expanded', 'true');
			hamburger.setAttribute('aria-label', 'Close menu');
			runAnim(animOpen);
		}

		function closeMenu() {
			overlay.classList.remove('is-open');
			overlay.setAttribute('aria-hidden', 'true');
			document.body.style.overflow = '';
			hamburger.setAttribute('aria-expanded', 'false');
			hamburger.setAttribute('aria-label', 'Menu');
			runAnim(animClose);
		}

		hamburger.addEventListener('click', function () {
			if (overlay.classList.contains('is-open')) {
				closeMenu();
			} else {
				openMenu();
			}
		});

		var overlayLinks = overlay.querySelectorAll('a');
		for (var i = 0; i < overlayLinks.length; i++) {
			overlayLinks[i].addEventListener('click', closeMenu);
		}

		document.addEventListener('keydown', function (e) {
			if (e.key === 'Escape' && overlay.classList.contains('is-open')) {
				closeMenu();
			}
		});
	});
</script>
