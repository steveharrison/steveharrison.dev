---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
import YouTubeIcon from '../assets/icons/youtube.svg';
import XIcon from '../assets/icons/x.svg';
import LinkedInIcon from '../assets/icons/linkedin.svg';
import GitHubIcon from '../assets/icons/github.svg';
import StackOverflowIcon from '../assets/icons/stackoverflow.svg';
import MenuIcon from '../assets/icons/menu.svg';
import CloseIcon from '../assets/icons/close.svg';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="nav-right">
			<div class="nav-links">
				<HeaderLink href="/">Home</HeaderLink>
				<HeaderLink href="/articles">Blog</HeaderLink>
			</div>
			<div class="social-links">
				<a href="https://www.youtube.com/@steve_harrison" target="_blank">
					<span class="sr-only">Follow Steve on YouTube</span>
					<YouTubeIcon width={20} height={20} aria-hidden="true" />
				</a>
				<a href="https://x.com/stevenaharrison" target="_blank">
					<span class="sr-only">Follow Steve on X</span>
					<XIcon width={20} height={20} aria-hidden="true" />
				</a>
				<a href="https://www.linkedin.com/in/stevenanthonyharrison/" target="_blank">
					<span class="sr-only">Go to Steve's LinkedIn profile</span>
					<LinkedInIcon width={20} height={20} aria-hidden="true" />
				</a>
				<a href="https://github.com/steveharrison" target="_blank">
					<span class="sr-only">Go to Steve's GitHub repo</span>
					<GitHubIcon width={20} height={20} aria-hidden="true" />
				</a>
				<a href="https://stackoverflow.com/users/48492/steve-harrison" target="_blank">
					<span class="sr-only">Go to Steve's StackOverflow profile</span>
					<StackOverflowIcon width={20} height={20} aria-hidden="true" />
				</a>
			</div>
		</div>
		<button class="hamburger" id="hamburger-btn" aria-label="Open menu">
			<MenuIcon width={20} height={20} />
		</button>
	</nav>
</header>

<!-- Full-screen mobile overlay -->
<div class="overlay" id="mobile-overlay">
	<div class="overlay-header">
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<button class="overlay-close" id="overlay-close-btn" aria-label="Close menu">
			<CloseIcon width={20} height={20} />
		</button>
	</div>
	<div class="overlay-nav">
		<a href="/">Home</a>
		<a href="/articles">Blog</a>
	</div>
	<div class="overlay-social">
		<a href="https://www.youtube.com/@steve_harrison" target="_blank">YouTube</a>
		<a href="https://x.com/stevenaharrison" target="_blank">X</a>
		<a href="https://www.linkedin.com/in/stevenanthonyharrison/" target="_blank">LinkedIn</a>
		<a href="https://github.com/steveharrison" target="_blank">GitHub</a>
		<a href="https://stackoverflow.com/users/48492/steve-harrison" target="_blank">Stack Overflow</a>
	</div>
</div>

<style>
	/* ---- Header bar ---- */
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		border-bottom: 1px solid rgb(var(--grey-light));
		position: sticky;
		top: 0;
		z-index: 100;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	
	nav {
		padding: 10px 0;
	}

	nav a {
		padding-top: 10px;
		padding-bottom: 2px;
		color: var(--black);
		text-decoration: none;
	}

	nav h2 {
		font-size: 20px;
		font-weight: 500;
	}

	.nav-right {
		display: flex;
		align-items: center;
		gap: 1em;
	}

	.nav-links, .social-links {
		display: flex;
		gap: 0.75rem;
	}
	
	.nav-links {
		margin-right: 10px;
	}

	.nav-links a, .social-links a {
		font-size: 0.95em;
		font-weight: 500;
		color: #000;
		transition: color 0.2s ease;
	}

	.nav-links a:hover,
	.social-links a:hover {
		color: var(--grey);
		border-color: var(--grey);
	}

	.social-links,
	.social-links a {
		display: flex;
	}

	/* ---- Hamburger button ---- */
	.hamburger {
		display: none;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.5em;
		color: rgb(var(--grey));
		-webkit-tap-highlight-color: transparent;
	}

	/* ---- Full-screen overlay ---- */
	.overlay {
		position: fixed;
		inset: 0;
		z-index: 999;
		background: rgba(255, 255, 255, 0.97);
		-webkit-backdrop-filter: blur(20px);
		backdrop-filter: blur(20px);
		display: flex;
		flex-direction: column;
		padding: 0 1.5em;
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.3s ease, visibility 0.3s ease;
	}

	.overlay.is-open {
		opacity: 1;
		visibility: visible;
	}

	.overlay-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1em 0;
	}

	.overlay-header h2 {
		margin: 0;
		font-size: 20px;
		font-weight: 500;
	}

	.overlay-header h2 a {
		text-decoration: none;
		color: rgb(var(--grey));
	}

	.overlay-close {
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.5em;
		color: rgb(var(--grey));
		-webkit-tap-highlight-color: transparent;
	}

	.overlay-nav {
		display: flex;
		flex-direction: column;
		padding-top: 1em;
		border-top: 1px solid rgb(var(--grey-light));
	}

	.overlay-nav a {
		font-size: 1.75em;
		font-weight: 600;
		color: rgb(var(--grey));
		text-decoration: none;
		padding: 0.5em 0;
		border-bottom: 1px solid rgb(var(--grey-light));
		transition: color 0.2s ease;
	}

	.overlay-nav a:hover {
		color: rgb(var(--accent));
	}

	.overlay-social {
		display: flex;
		flex-direction: column;
		gap: 0;
		padding-top: 1.5em;
	}

	.overlay-social a {
		font-size: 1em;
		font-weight: 500;
		color: rgb(var(--grey));
		text-decoration: none;
		padding: 0.6em 0;
		transition: color 0.2s ease;
	}

	.overlay-social a:hover {
		color: rgb(var(--accent));
	}

	/* ---- Responsive ---- */
	@media (max-width: 600px) {
		.nav-right {
			display: none;
		}
		.hamburger {
			display: block;
		}
	}

	@media (min-width: 601px) {
		.hamburger {
			display: none !important;
		}
		.overlay {
			display: none !important;
		}
	}

	@media (min-width: 601px) and (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>

<script is:inline>
	document.addEventListener('DOMContentLoaded', function () {
		var hamburger = document.getElementById('hamburger-btn');
		var overlay = document.getElementById('mobile-overlay');
		var closeBtn = document.getElementById('overlay-close-btn');

		function openMenu() {
			overlay.classList.add('is-open');
			document.body.style.overflow = 'hidden';
			hamburger.setAttribute('aria-expanded', 'true');
		}

		function closeMenu() {
			overlay.classList.remove('is-open');
			document.body.style.overflow = '';
			hamburger.setAttribute('aria-expanded', 'false');
		}

		hamburger.addEventListener('click', openMenu);
		closeBtn.addEventListener('click', closeMenu);

		// Close on link click
		var overlayLinks = overlay.querySelectorAll('a');
		for (var i = 0; i < overlayLinks.length; i++) {
			overlayLinks[i].addEventListener('click', closeMenu);
		}

		// Close on Escape key
		document.addEventListener('keydown', function (e) {
			if (e.key === 'Escape' && overlay.classList.contains('is-open')) {
				closeMenu();
			}
		});
	});
</script>
