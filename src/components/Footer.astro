---
const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} Steve Harrison</p>
	<p class="legal-links">
		<a href="/privacy">Privacy</a>
		<span aria-hidden="true">&middot;</span>
		<a href="/terms">Terms</a>
	</p>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--grey-gradient)) no-repeat;
		color: rgb(var(--grey));
		text-align: center;
	}
	footer p {
		margin: 0;
	}
	.legal-links {
		margin-top: 0.5em;
		font-size: 0.9em;
		display: flex;
		justify-content: center;
		gap: 0.5em;
	}
	.legal-links a {
		color: rgb(var(--grey));
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1em;
		margin-top: 1em;
	}
	.social-links a {
		text-decoration: none;
		color: rgb(var(--grey));
	}
	.social-links a:hover {
		color: rgb(var(--grey));
	}
</style>
