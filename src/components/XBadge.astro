---
import type { XPost } from '../lib/xposts';

interface Props {
	post: XPost;
}

const { post } = Astro.props;
// 7154 → "7.2K", matching how X itself shortens counts.
const compact = new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 });
---

<a
	class="x-badge"
	href={post.url}
	target="_blank"
	rel="noopener noreferrer"
	title="Post on X"
	aria-label={`${post.views} views and ${post.likes} likes on X`}
>
	<span class="x-logo" aria-hidden="true">
		<svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 1.2h3.7l-8 9.2L24 22.8h-7.4l-5.8-7.6-6.6 7.6H.5l8.6-9.8L0 1.2h7.6l5.2 6.9 6.1-6.9Zm-1.3 19.4h2L6.5 3.3H4.3l13.3 17.3Z" /></svg>
	</span>
	<span>{compact.format(post.views)}<span class="x-unit"> views</span></span>
	<span class="x-sep" aria-hidden="true">·</span>
	<span>{post.likes}<span class="x-unit"> likes</span></span>
</a>

<style>
	/* Same shape as HackerNewsBadge, in X's monochrome. */
	.x-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
		flex-shrink: 0;
		padding: 0.2em 0.55em 0.2em 0.25em;
		border: 1px solid #e1e1e4;
		border-radius: 999px;
		background: #f6f6f7;
		color: #111;
		font-size: 0.75rem;
		font-weight: 600;
		line-height: 1.4;
		text-decoration: none;
		white-space: nowrap;
		transition: background-color 150ms ease, transform 160ms var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.x-badge:hover {
			background: #ececee;
		}
	}

	.x-badge:active {
		transform: scale(0.97);
	}

	.x-logo {
		display: inline-grid;
		place-items: center;
		width: 1.25em;
		height: 1.25em;
		border-radius: 4px;
		background: #000;
		color: #fff;
	}

	.x-unit {
		font-weight: 500;
	}

	.x-sep {
		color: #a0a0a8;
	}
</style>
