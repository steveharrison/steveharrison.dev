---
import type { SocialPost } from '../data/portfolio';

interface Props {
	post: SocialPost;
}

const { post } = Astro.props;
const label = post.platform === 'x' ? 'Post on X' : 'Post on LinkedIn';
---

<a class:list={['social-chip', post.platform]} href={post.url} target="_blank" rel="noopener noreferrer" title={label}>
	<span class="social-logo" aria-hidden="true">
		{post.platform === 'x' ? (
			<svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 1.2h3.7l-8 9.2L24 22.8h-7.4l-5.8-7.6-6.6 7.6H.5l8.6-9.8L0 1.2h7.6l5.2 6.9 6.1-6.9Zm-1.3 19.4h2L6.5 3.3H4.3l13.3 17.3Z" /></svg>
		) : (
			<svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45Z" /></svg>
		)}
	</span>
	<span class="visually-hidden">{label}: </span>{post.stats}
</a>

<style>
	/* Same shape as the Hacker News and X badges on the article lists. */
	.social-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		padding: 0.2em 0.6em 0.2em 0.25em;
		border-radius: 999px;
		font-size: 0.75rem;
		font-weight: 600;
		line-height: 1.4;
		text-decoration: none;
		white-space: nowrap;
	}

	.social-chip.x {
		border: 1px solid #e1e1e4;
		background: #f6f6f7;
		color: #111;
	}

	.social-chip.linkedin {
		border: 1px solid #cfe0f3;
		background: #f1f7fd;
		color: #0a4f9c;
	}

	.social-logo {
		display: inline-grid;
		place-items: center;
		width: 1.25em;
		height: 1.25em;
		border-radius: 4px;
		color: #fff;
	}

	.x .social-logo {
		background: #000;
	}

	.linkedin .social-logo {
		background: #0a66c2;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
</style>
