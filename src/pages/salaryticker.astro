---
// Deliberately standalone: no BaseHead/Header/Footer, so the landing page keeps
// its own bare styling rather than inheriting the site chrome.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const description = "A tiny macOS menubar app that shows how much you've earned so far today.";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Salary Ticker</title>
  <meta name="description" content={description}>
  <!-- The app's own icon, rather than the site favicon. -->
  <link rel="icon" type="image/png" sizes="32x32" href="/salaryticker/icon-32.png">
  <link rel="icon" type="image/png" sizes="512x512" href="/salaryticker/icon-512.png">
  <link rel="apple-touch-icon" href="/salaryticker/icon-180.png">
  <link rel="canonical" href={canonicalURL}>

  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:title" content="Salary Ticker">
  <meta property="og:description" content={description}>
  <meta property="og:image" content={new URL('/content/images/thumbnail/salaryticker.png', Astro.site)}>
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:title" content="Salary Ticker">
  <meta property="twitter:description" content={description}>
  <meta property="twitter:image" content={new URL('/content/images/thumbnail/salaryticker.png', Astro.site)}>

  <!-- Google analytics -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-X4CHT5LFX4"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-X4CHT5LFX4');
  </script>

  <style>
    * { margin: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
      background: #fff;
      color: #111;
      display: flex;
      justify-content: center;
      padding: 96px 24px;
    }
    main {
      width: 100%;
      max-width: 640px;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 24px;
    }
    h1 {
      font-size: 2.5rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    p.tagline {
      font-size: 1.125rem;
      color: #555;
      line-height: 1.6;
      max-width: 46ch;
    }
    video.demo {
      width: 100%;
      max-width: 470px;
      height: auto;
      display: block;
      border-radius: 8px;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.12);
    }
    img.settings {
      width: 100%;
      max-width: 487px;
      height: auto;
      display: block;
      /* The capture has the window shadow and clear padding baked in,
         so pull the surrounding gaps in a little. */
      margin: -24px 0;
    }
    a.download {
      display: inline-block;
      background: #111;
      color: #fff;
      text-decoration: none;
      font-size: 1rem;
      font-weight: 600;
      padding: 14px 32px;
      border-radius: 10px;
    }
    a.download:hover { background: #333; }
    .fine-print {
      font-size: 0.8rem;
      color: #999;
    }
    .fine-print a {
      color: #999;
    }
  </style>
</head>
<body>
  <main>
    <h1>Salary Ticker</h1>
    <p class="tagline">A tiny macOS menubar app that shows how much you've earned so far today, ticking up in real time.</p>

    <video class="demo" src="/salaryticker/demo.mp4" autoplay loop muted playsinline></video>

    <img class="settings" src="/salaryticker/settings.png" alt="Salary Ticker settings window: daily pay, day start and end times, and automatic masking while screen sharing">

    <a class="download" href="/salaryticker/SalaryTicker.zip" download>Download for macOS</a>
    <p class="fine-print">Free · macOS 13 or later · No data leaves your Mac</p>
    <p class="fine-print">
      <a href="/">By Steve Harrison</a> ·
      <a href="/privacy">Privacy</a> ·
      <a href="/terms">Terms</a>
    </p>
  </main>

  <script is:inline>
    document.querySelector('a.download').addEventListener('click', function () {
      gtag('event', 'download', {
        app_name: 'Salary Ticker',
        file_name: 'SalaryTicker.zip',
        link_url: this.href,
      });
    });
  </script>
</body>
</html>
