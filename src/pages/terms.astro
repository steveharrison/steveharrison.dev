<style>
	main {
		max-width: 720px;
		margin: 0 auto;
		padding: 1em;
	}

	main > h1 {
		font-size: 2em;
		font-weight: 700;
		margin: 1em 0 0.4em;
	}

	.updated {
		color: rgb(var(--grey));
		font-size: 0.9em;
		margin-bottom: 2em;
	}

	main h2 {
		font-size: 1.25em;
		font-weight: 700;
		margin: 2em 0 0.6em;
		border: none;
		padding: 0;
	}

	main p {
		margin-bottom: 1em;
		line-height: 1.6;
	}

	main ul {
		margin: 0 0 1em 1.2em;
		line-height: 1.6;
	}

	main li {
		margin-bottom: 0.4em;
	}

	main code {
		font-size: 0.9em;
		background: rgba(var(--grey-light), 0.5);
		padding: 0.1em 0.35em;
		border-radius: 4px;
	}
</style>
