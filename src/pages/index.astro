// Logos shown beside each open source project's name in its lightbox.
const projectIcons: Record<string, string> = {
	'Chrome DevTools': '/content/images/tech/googlechrome.svg',
	Preact: '/content/images/tech/preact.svg',
	React: '/content/images/tech/react.svg',
	'Stack Overflow': '/content/images/tech/stackoverflow.svg',
};

// Contributions grouped by project, in the order each project first appears. Hidden ones are left
// out, but keep their index so the lightbox ids still line up.
const ossGroups = [
	...Map.groupBy(
		contributions.map((contribution, index) => ({ contribution, index })).filter(({ contribution }) => !contribution.hidden),
		({ contribution }) => contribution.project,
	),
];

// Popular articles, shown newest first.
const articles = [...posts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// The career timeline, newest first. The current role and any featured roles are shown
// in full; the rest open in the lightbox. Each role is labelled on the timescale with the
// year it started, unless the role above it started that year too. Roles are sorted by
// start year; within a year they keep their order in the career data (a stable sort).
const [currentRole] = career;
const timeline = career
	.toSorted((a, b) => b.start.slice(0, 4).localeCompare(a.start.slice(0, 4)))
	.map((role, i, roles) => {
		const year = role.start.slice(0, 4);
		return {
			role,
			year: i > 0 && roles[i - 1].start.startsWith(year) ? '' : year,
			full: role === currentRole || role.featured,
		};
	});

// Roles with no media and only a few lines of text are shown in full on the card.
function isShortRole(role: (typeof career)[number]) {
	const text = (role.summary ?? '') + (role.highlights ?? []).join(' ');
	return !role.media?.length && text.length <= 320;
}

// "Lead Front End Developer · Contract → Perm", from the role's title and the
// employment types in its resume terms (e.g. "Contract: 2015 – 2016 • Perm 2016 – 2020").
function roleSubtitle(role: (typeof career)[number]) {
	const types = role.terms
		.split('•')
		.map((part) => part.split(':')[0].replace(/\d.*$/, '').trim())
		.filter(Boolean);
	return [role.title, types.join(' → ')].filter(Boolean).join(' · ');
}

// Turn a unified diff into plain code plus the line numbers Expressive Code should mark
// as inserted/deleted, so the full diff in the lightbox keeps syntax highlighting.
function parseDiff(diff: string, lang: string) {
	const lines: string[] = [];
	const ins: number[] = [];
	const del: number[] = [];
	let title = '';
	for (const line of diff.split('\n')) {
		if (line.startsWith('+++ b/')) title = line.slice(6);
		else if (line.startsWith('---')) continue;
		else if (line.startsWith('@@')) {
			if (lines.length) lines.push(lang === 'css' ? '/* … */' : '// …');
		} else {
			if (line[0] === '+') ins.push(lines.length + 1);
			if (line[0] === '-') del.push(lines.length + 1);
			lines.push(line.slice(1));
		}
	}
	return { code: lines.join('\n'), meta: `title="${title}" ins={${ins.join(',')}} del={${del.join(',')}}` };
}
