---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

// Fetch latest videos from YouTube at build time
const YOUTUBE_CHANNEL_URL = 'https://www.youtube.com/@steve_harrison/videos';
let videos: { title: string; thumbnail: string; href: string }[] = [];

try {
	const res = await fetch(YOUTUBE_CHANNEL_URL);
	const html = await res.text();
	const match = html.match(/var ytInitialData = ({.*?});<\/script>/);
	if (match) {
		const data = JSON.parse(match[1]);
		const tabs = data.contents.twoColumnBrowseResultsRenderer.tabs;
		for (const tab of tabs) {
			if (tab.tabRenderer?.title === 'Videos') {
				const items = tab.tabRenderer.content.richGridRenderer.contents;
				for (const item of items.slice(0, 3)) {
					if (item.richItemRenderer) {
						const vid = item.richItemRenderer.content.videoRenderer;
						videos.push({
							title: vid.title.runs[0].text,
							thumbnail: `https://i.ytimg.com/vi/${vid.videoId}/mqdefault.jpg`,
							href: `https://www.youtube.com/watch?v=${vid.videoId}`,
						});
					}
				}
				break;
			}
		}
	}
} catch (e) {
	console.warn('Failed to fetch YouTube videos:', e);
}

const projects = [
	{
		title: "The Finances App",
		description: "A local-first personal finance app for analysing spending across multiple accounts.",
		image: "/content/images/thumbnail/the-finances-app.png",
		href: "https://thefinances.app",
	},
	{
		title: "CSS Advent Calendar",
		description: "Created an advent calendar in 2024 + 2025 to showcase new CSS & JS features.",
		image: "/content/images/thumbnail/css-advent-calendar.png",
		href: "https://cssadventcalendar.dev",
	},
	{
		title: "Dazzle",
		description: "I built a self-updating framework for Apple Dashboard widgets back in high school.",
		image: "/content/images/thumbnail/dazzle.png",
		href: "https://thefinances.app",
	}
];

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<!-- Hero -->
			<section class="hero">
				<img
					src="/content/images/thumbnail/profile-pic.png"
					alt="Steve Harrison"
					class="hero-avatar"
					width="120"
					height="120"
				/>
				<div class="hero-text">
					<h1>Hey, I'm Steve.</h1>
					<p class="bio">
						I’m a Senior Front End Developer at <a href="https://qantas.com">Qantas</a> and I'm building <a href="https://thefinances.app">The Finances App</a> in my spare time. I focus on building performant, accessible, and secure websites that deliver high business value and great user experiences. I've worked for a variety of Australian  companies, spoken at meetups/conferences in Sydney, contributed to open source projects including Preact, and answered questions on StackOverflow since 2008.
					</p>
				</div>
			</section>

			<!-- Recent Articles & Videos (side by side on desktop) -->
			<div class="lists-row">
				<section class="list-section">
					<div class="section-header">
						<h2>Recent Articles</h2>
						<a href="/articles" class="view-all">
							View All
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8l4 4-4 4"/><path d="M8 12h8"/></svg>
						</a>
					</div>
					<ul class="item-list">
						{posts.map((post) => (
							<li>
								<a href={`/${post.id}/`}>
									<svg class="item-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
									<div class="item-content">
										<div class="item-main">
											<span class="item-title">{post.data.title}</span>
											<span class="item-date"><FormattedDate date={post.data.pubDate} /></span>
										</div>
										{post.data.description && <span class="item-description">{post.data.description}</span>}
									</div>
								</a>
							</li>
						))}
					</ul>
				</section>

				<section class="list-section">
					<div class="section-header">
						<h2>Recent Videos</h2>
						<a href="#" class="view-all">
							View All
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8l4 4-4 4"/><path d="M8 12h8"/></svg>
						</a>
					</div>
					<ul class="item-list">
						{videos.map((video) => (
							<li>
								<a href={video.href} target="_blank">
									<img class="video-thumb" src={video.thumbnail} alt="" width="72" height="40" loading="lazy" />
									<div class="item-content">
										<span class="item-title">{video.title}</span>
									</div>
								</a>
							</li>
						))}
					</ul>
				</section>
			</div>

			<!-- Projects -->
			<section class="card-section">
				<div class="section-header">
					<h2>Projects</h2>
					<a href="#" class="view-all">
						View All
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8l4 4-4 4"/><path d="M8 12h8"/></svg>
					</a>
				</div>
				<div class="card-grid">
					{projects.map((project) => (
						<a href={project.href} class="card">
							<div class="card-image">
								<img src={project.image} alt={project.title} />
							</div>
							<div class="card-body">
								<h3>{project.title}</h3>
								<p>{project.description}</p>
							</div>
						</a>
					))}
				</div>
			</section>

			<!-- Work -->
			<!--
			<section class="card-section">
				<div class="section-header">
					<h2>Work</h2>
					<a href="#" class="view-all">
						View All
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8l4 4-4 4"/><path d="M8 12h8"/></svg>
					</a>
				</div>
				<div class="card-grid">
					{work.map((item) => (
						<a href={item.href} class="card">
							<div class="card-image">
								<img src={item.image} alt={item.title} />
							</div>
							<div class="card-body">
								<h3>{item.title}</h3>
								<p>{item.description}</p>
							</div>
						</a>
					))}
				</div>
			</section>
			-->
		</main>
		<Footer />
	</body>
</html>

<style>
	* {
		box-sizing: border-box;
	}

	main {
		width: auto;
		margin: 0 auto;
		padding: 1em;
		max-width: 960px;
	}

	.hero-text {
		min-width: 0;
		flex: 1;
	}

	.hero-text h1,
	.bio {
		overflow-wrap: anywhere;
	}

	.card {
		min-width: 0;
	}

	.card-body h3,
	.card-body p {
		overflow-wrap: anywhere;
	}

	/* Hero */
	.hero {
		display: flex;
		align-items: center;
		gap: 2em;
		padding: 3em 0;
		border-bottom: 1px solid rgb(var(--grey-light));
		margin-bottom: 2.5em;
	}

	.hero-avatar {
		width: 120px;
		height: 120px;
		border-radius: 50%;
		object-fit: cover;
		flex-shrink: 0;
	}

	.hero-text h1 {
		font-size: 2.2em;
		font-weight: 700;
		margin: 0 0 0.4em 0;
		line-height: 1.2;
	}

	.bio {
		font-size: 1.05em;
		line-height: 1.6;
		color: rgb(var(--grey));
		margin: 0;
	}

	/* Section headers */
	.section-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
		margin-bottom: 1em;
	}

	.section-header h2 {
		font-size: 1.4em;
		font-weight: 700;
		margin: 0;
		border: none;
		padding: 0;
		white-space: nowrap;
	}

	.view-all {
		display: flex;
		align-items: center;
		gap: 0.4em;
		font-size: 0.9em;
		font-weight: 500;
		color: rgb(var(--grey));
		text-decoration: none;
		transition: color 0.2s ease;
		white-space: nowrap;
		flex-shrink: 0;
	}

	.view-all:hover {
		color: rgb(var(--accent));
	}

	.view-all svg {
		transition: transform 0.2s ease;
	}

	.view-all:hover svg {
		transform: translateX(2px);
	}

	/* Lists row (Articles + Videos side by side) */
	.lists-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2.5em;
		margin-bottom: 3em;
		overflow: hidden;
	}

	/* List sections (Articles / Videos) */
	.list-section {
		min-width: 0;
		margin-bottom: 0;
	}

	.item-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.item-list li {
		border-bottom: 1px solid rgb(var(--grey-light));
	}

	.item-list li:last-child {
		border-bottom: none;
	}

	.item-list a {
		display: flex;
		align-items: center;
		gap: 1em;
		padding: 0.85em 0.5em;
		text-decoration: none;
		color: inherit;
		transition: background 0.15s ease;
		border-radius: 6px;
	}

	.item-list a:hover {
		background: rgba(var(--grey-light), 0.4);
	}

	.item-icon {
		flex-shrink: 0;
		color: rgb(var(--grey));
	}

	.video-thumb {
		flex-shrink: 0;
		width: 72px;
		height: 40px;
		object-fit: cover;
		border-radius: 4px;
	}

	.item-content {
		display: flex;
		flex-direction: column;
		flex: 1;
		min-width: 0;
	}

	.item-main {
		display: flex;
		justify-content: space-between;
		align-items: center;
		min-width: 0;
		gap: 1em;
	}

	.item-description {
		font-size: 0.82em;
		color: rgb(var(--grey));
		margin-top: 0.2em;
		line-height: 1.4;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.item-title {
		font-weight: 500;
		font-size: 0.95em;
		color: rgb(var(--grey));
		min-width: 0;
		word-wrap: break-word;
		overflow-wrap: anywhere;
	}

	.item-date {
		font-size: 0.82em;
		color: rgb(var(--grey));
		flex-shrink: 0;
		margin-left: 1em;
	}

	/* Card sections (Projects / Work) */
	.card-section {
		margin-bottom: 3em;
	}

	.card-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5em;
	}

	.card {
		text-decoration: none;
		color: inherit;
		border: 1px solid rgb(var(--grey-light));
		border-radius: 10px;
		overflow: hidden;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.card:hover {
		transform: translateY(-3px);
		box-shadow: 0 6px 20px rgba(var(--black), 0.08);
	}

	.card-image {
		width: 100%;
		aspect-ratio: 16 / 10;
		overflow: hidden;
	}

	.card-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.card-body {
		padding: 1em;
	}

	.card-body h3 {
		font-size: 1em;
		font-weight: 600;
		margin: 0 0 0.4em 0;
		color: rgb(var(--grey));
	}

	.card-body p {
		font-size: 0.85em;
		color: rgb(var(--grey));
		margin: 0;
		line-height: 1.5;
	}

	/* Responsive */
	@media (max-width: 600px) {
		main {
			padding: 0.75em;
		}

		.hero {
			flex-direction: column;
			text-align: center;
			gap: 1.2em;
			padding: 1.5em 0;
		}

		.hero-avatar {
			width: 80px;
			height: 80px;
		}

		.hero-text h1 {
			font-size: 1.5em;
		}

		.bio {
			font-size: 0.9em;
		}

		.lists-row {
			grid-template-columns: 1fr;
			gap: 2em;
		}

		.card-grid {
			grid-template-columns: 1fr;
			max-width: 320px;
		}

		.item-list a {
			gap: 0.75em;
			padding: 0.75em 0.25em;
		}

		.item-main {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.15em;
		}

		.item-date {
			margin-left: 0;
		}

		.section-header h2 {
			font-size: 1.15em;
		}

		.view-all {
			white-space: nowrap;
			font-size: 0.82em;
		}

		.card-body h3 {
			font-size: 0.9em;
		}

		.card-body p {
			font-size: 0.8em;
		}
	}

	@media (min-width: 601px) and (max-width: 768px) {
		.hero-text h1 {
			font-size: 1.8em;
		}

		.lists-row {
			grid-template-columns: 1fr;
			gap: 2em;
		}

		.card-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 769px) and (max-width: 960px) {
		.card-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
