<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<!-- Hero -->
			<section class="hero">
				<!-- A print with a white border, its corners curling off the page, held by a paperclip. -->
				<figure class="print">
					<span class="print-paper"><img
						src="/content/images/thumbnail/profile-pic.png"
						alt="Steve Harrison"
						class="hero-avatar"
						width="150"
						height="150"
					/></span>
					<svg class="paperclip" width="22" height="58" viewBox="0 0 22 58" fill="none" aria-hidden="true">
						<defs>
							<linearGradient id="clip-metal" x1="0" y1="0" x2="1" y2="1">
								<stop offset="0" stop-color="#d9dde2" />
								<stop offset="0.5" stop-color="#8d949c" />
								<stop offset="1" stop-color="#c3c8ce" />
							</linearGradient>
						</defs>
						<path d="M7 18V9a4 4 0 0 1 8 0v37a7.5 7.5 0 0 1-15 0V14" stroke="url(#clip-metal)" stroke-width="2.4" stroke-linecap="round" transform="translate(3 2)" />
						<path d="M7 18V9a4 4 0 0 1 8 0v37a7.5 7.5 0 0 1-15 0V14" stroke="rgba(255,255,255,0.7)" stroke-width="0.6" stroke-linecap="round" transform="translate(2.6 1.6)" />
					</svg>
				</figure>
				<div class="hero-text">
					<h1>Hey, I'm Steve.</h1>
					<p class="bio bio-lead">
						I’m a Senior Front End Developer at <a href="https://qantas.com" class="bio-link"><img class="bio-link-icon-qantas" src="/content/images/icons/qantas.png" alt="" width="20" height="20" />Qantas</a> and I’m building <a href="https://thefinances.app" class="bio-link"><img class="bio-link-icon-finances" src="/content/images/icons/the-finances-app.png" alt="" width="20" height="20" />The Finances App</a> in my spare time.
					</p>
					<p class="bio">
						I've worked on UIs for booking &amp; managing flights, staking crypto, viewing aerial imagery, and publishing tsunami warnings.
						I’ve also spoken at Web Directions and SydCSS
						<a class="intro-chip" href="https://www.youtube.com/watch?v=rtXmM7uHyrg&t=613s" data-lightbox="talk-1" title="Watch my SydCSS talk"><svg width="14" height="10" viewBox="0 0 20 14" aria-hidden="true"><rect width="20" height="14" rx="4" fill="#ff0033" /><path d="M8 4v6l5-3z" fill="#fff" /></svg>What’s new in CSS in 2023</a>,
						contributed fixes to <span class="bio-term"><img class="bio-icon" src="/content/images/tech/preact.svg" alt="" width="16" height="16" />Preact</span>
						<a class="intro-chip" href="https://github.com/preactjs/preact/pull/2366" data-lightbox="oss-2" title="Fix JSX SVG attribute names">#2366</a>
						and <span class="bio-term"><img class="bio-icon" src="/content/images/tech/googlechrome.svg" alt="" width="16" height="16" />Chrome DevTools</span>
						<a class="intro-chip" href="https://chromium-review.googlesource.com/c/devtools/devtools-frontend/+/8435023" data-lightbox="oss-0" title="Fix clipped focus ring on the “No throttling” select">Focus ring fix</a>
						<a class="intro-chip" href="https://chromium-review.googlesource.com/c/devtools/devtools-frontend/+/8458362" data-lightbox="oss-1" title="Fix focused list item gradient in dark mode">Dark mode fix</a>,
						and answered questions on <span class="bio-term"><img class="bio-icon" src="/content/images/tech/stackoverflow.svg" alt="" width="16" height="16" />Stack Overflow</span>
						<a class="so-chip" href="https://stackoverflow.com/users/48492/steve-harrison" title={`${stackOverflowReputation.toLocaleString('en')} reputation`}>
							<StackOverflowIcon width={12} height={12} aria-hidden="true" />{reputationLabel}<span class="so-unit">rep</span>
						</a>
						since 2008 (back when that was a thing).
					</p>
				</div>
			</section>

			<!-- Projects: just icons and names; each opens its full story in the lightbox. -->
			<section class="apps-section">
				<div class="section-header">
					<h2>Side Projects</h2>
				</div>
				<ul class="app-grid">
					{projects.map((project) => (
						<li>
							<button type="button" class="app-tile" data-lightbox={`app-${project.slug}`}>
								<img class:list={['app-icon', project.iconShadow && 'has-shadow']} src={project.appIcon} alt="" width="72" height="72" loading="lazy" />
								<span class="app-name">{project.title}</span>
								<span class="app-years">{project.years}</span>
							</button>
						</li>
					))}
				</ul>
			</section>

			<!-- Open Source: each contribution on a card; Stack Overflow shows its top posts inline. -->
			<section class="home-section">
				<div class="section-header">
					<h2>Open Source</h2>
				</div>
				{ossGroups.map(([project, items]) => (
					<div class="oss-group">
						<h3 class="oss-heading">
							{projectIcons[project] && <img src={projectIcons[project]} alt="" width="18" height="18" />}
							{project}
						</h3>
						<ul class="item-list oss-list">
							{items.map(({ contribution, index }) => (
								<li class="card">
									<a href={contribution.href} target="_blank" data-lightbox={contribution.posts ? undefined : `oss-${index}`}>
										<div class="item-content">
											<div class="item-main">
												<span class="item-title">{contribution.title}</span>
												<span class="item-date">{contribution.merged ? postedDate.format(new Date(contribution.merged)) : contribution.date}</span>
											</div>
											<span class="item-description"><Markdown text={contribution.description} /></span>
										</div>
									</a>
									{contribution.posts && (
										<ul class="so-chips">
											{contribution.posts.map((post) => (
												<li>
													<a href={post.href} target="_blank" rel="noopener noreferrer" title={`${post.kind} · ${postedAt.format(new Date(post.date))}`}>
														<span class="so-chip-score" aria-label={`${post.score.toLocaleString('en')} votes`}>▲ {post.score.toLocaleString('en')}</span>
														<span class="so-chip-title">{post.title}</span>
														<time class="so-chip-date" datetime={post.date}>{postedDate.format(new Date(post.date))}</time>
													</a>
												</li>
											))}
										</ul>
									)}
								</li>
							))}
						</ul>
					</div>
				))}
			</section>

			<!-- Articles: three cards in a row. -->
			<section class="home-section">
				<div class="section-header">
					<h2>Articles</h2>
					<a href="/articles" class="view-all">View All <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8l4 4-4 4"/><path d="M8 12h8"/></svg></a>
				</div>
				<ArticleGrid posts={articles} />
			</section>

			<!-- Career: a timeline, newest first. The current and featured roles are shown in full;
			     the rest are compact cards that open in the lightbox. -->
			<section class="home-section">
				<div class="section-header">
					<h2>Career</h2>
				</div>
				<ol class="timeline">
					{timeline.map(({ role, year, full }) => {
						const head = (
							<span class="role-head">
								{role.logo ? <img class="logo logo-row" src={role.logo} alt="" width="40" height="40" loading="lazy" /> : <span class="logo logo-row logo-initials" aria-hidden="true">{role.initials}</span>}
								<span class="role-name">
									<span class="role-company">{role.company}</span>
									{roleSubtitle(role) && <span class="role-title">{roleSubtitle(role)}</span>}
								</span>
							</span>
						);
						const techIcons = role.tech && (
							<span class="role-tech" aria-label="Tech stack">
								{role.tech.map((id) => tech[id] && (
									<img src={tech[id].icon} alt={tech[id].name} title={tech[id].name} width="16" height="16" loading="lazy" />
								))}
							</span>
						);
						// Inline roles: small screenshots (a video shows its poster) that each zoom open.
						const thumbs = role.inline && role.media && (
							<ul class:list={['role-thumbs', `is-${role.inline}`]}>
								{role.media.map((item, i) => {
									const src = item.video ? item.poster : item.src;
									const aspect = src && thumbAspect.get(src);
									return (
										<li style={aspect ? `--ar: ${aspect}` : undefined}>
											<button type="button" data-lightbox={`shot-${role.slug}-${i}`} aria-label={`Enlarge: ${item.alt}`}>
												<img src={src} alt="" loading="lazy" />
												{item.video && (
													<span class="thumb-play" aria-hidden="true"><svg width="10" height="12" viewBox="0 0 10 12"><path d="M0 0l10 6-10 6z" fill="currentColor" /></svg></span>
												)}
											</button>
										</li>
									);
								})}
							</ul>
						);
						return (
							<li class:list={['tl-item', role === currentRole && 'is-current']}>
								<span class="tl-year">{year}</span>
								<div class="tl-card">
									{full ? (
										<article class="current-role">
											<div class="lb-heading">
												{role.logo ? <img class="logo logo-large" src={role.logo} alt="" width="56" height="56" /> : <span class="logo logo-large logo-initials" aria-hidden="true">{role.initials}</span>}
												<div>
													<h3>{role.company}</h3>
													<p class="lb-meta">{role.terms}</p>
												</div>
											</div>
											{role.summary && <p><Markdown text={role.summary} /></p>}
											{role.highlights && <ul class="lb-highlights">{role.highlights.map((item) => <li><Markdown text={item} /></li>)}</ul>}
											{role.tech && (
												<ul class="lb-tech">
													{role.tech.map((id) => tech[id] && (
														<li><span><img src={tech[id].icon} alt="" width="16" height="16" />{tech[id].name}</span></li>
													))}
												</ul>
											)}
											{thumbs || role.media && (
												<div class="lb-media">
													{role.media.map((item) => (
														<figure class:list={[item.fit && `fit-${item.fit}`]}>
															{item.video ? (
																<video src={item.src} poster={item.poster} controls playsinline preload="none" aria-label={item.alt}></video>
															) : (
																<img src={item.src} alt={item.alt} loading="lazy" />
															)}
															<figcaption>{item.alt}</figcaption>
														</figure>
													))}
												</div>
											)}
										</article>
									) : (
										<>
											{role.inline ? (
												/* Everything in place; the screenshots open one at a time. */
												<div class="role-card is-static">
													<span class="role-body">
													{head}
													{role.summary && <p class="role-detail"><Markdown text={role.summary} /></p>}
													{role.highlights && (
														<ul class="role-highlights">{role.highlights.map((item) => <li><Markdown text={item} /></li>)}</ul>
													)}
													{techIcons}
													{thumbs}
													</span>
												</div>
											) : isShortRole(role) ? (
												/* Little to say: show it all in place, no lightbox. */
												<div class="role-card is-static">
													<span class="role-body">
													{head}
													{role.summary && <p class="role-detail"><Markdown text={role.summary} /></p>}
													{role.highlights && (
														<ul class="role-highlights">{role.highlights.map((item) => <li><Markdown text={item} /></li>)}</ul>
													)}
													{techIcons}
													</span>
												</div>
											) : (
												<button type="button" class:list={['role-card', role.media && 'has-header']} data-lightbox={`role-${role.slug}`}>
													<span class="role-expand" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M6 1.5v9M1.5 6h9" /></svg></span>
													{role.media && (() => {
														const item = role.media[0];
														return (
															<span class="role-header">
																{item.video ? (
																	<video src={item.src} poster={item.poster} muted loop playsinline preload="none" data-inview-play aria-hidden="true"></video>
																) : (
																	<img src={item.src} alt="" loading="lazy" />
																)}
															</span>
														);
													})()}
													<span class="role-body">
														{head}
														{techIcons}
													</span>
												</button>
											)}
										</>
									)}
								</div>
							</li>
						);
					})}
				</ol>
			</section>

			<!-- Speaking: a grid of talk cards, with a photo or recording where there is one. -->
			<section class="home-section">
				<div class="section-header">
					<h2>Speaking</h2>
				</div>
				<ul class="media-grid">
					{talks.map((talk, i) => {
						const body = (
							<>
								<span class:list={['media-thumb', !(talk.youtubeId || talk.image) && 'media-thumb-empty']}>
									{talk.youtubeId || talk.image ? (
										<img src={talk.image ?? `https://i.ytimg.com/vi/${talk.youtubeId}/mqdefault.jpg`} alt="" width="320" height="180" loading="lazy" />
									) : (
										<span class="talk-placeholder"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="2" width="6" height="12" rx="3" /><path d="M5 10a7 7 0 0 0 14 0" /><path d="M12 17v4" /><path d="M8 21h8" /></svg><span>{talk.event?.split(",")[0] ?? "Talk"}</span></span>
									)}
									{talk.youtubeId && <><svg class="play-badge" width="28" height="20" viewBox="0 0 20 14" aria-hidden="true"><rect width="20" height="14" rx="4" fill="#ff0033" /><path d="M8 4v6l5-3z" fill="#fff" /></svg></>}
								</span>
								<span class="media-title">{talk.title}</span>
								<span class="media-meta">
									{[talk.event, talk.date && postedDate.format(new Date(talk.date))].filter(Boolean).join(' · ')}
									{talk.alsoGiven && <><br />{talk.alsoGiven.event} · {postedDate.format(new Date(talk.alsoGiven.date))}</>}
								</span>
							</>
						);
						return (
							<li>
								{talk.href ? (
									<a class="media-card" href={talk.href} target="_blank" rel="noopener noreferrer" data-lightbox={`talk-${i}`}>{body}</a>
								) : (
									<button type="button" class="media-card" data-lightbox={`talk-${i}`}>{body}</button>
								)}
							</li>
						);
					})}
				</ul>
			</section>

			<!-- Videos: big thumbnails that play in the lightbox. -->
			<section class="home-section">
				<div class="section-header">
					<h2>Videos</h2>
					<a href={YOUTUBE_CHANNEL_URL} target="_blank" class="view-all">View All <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8l4 4-4 4"/><path d="M8 12h8"/></svg></a>
				</div>
				<ul class="media-grid">
					{videos.map((video) => (
						<li>
							<a class="media-card" href={video.href} target="_blank" data-lightbox={`video-${video.id}`}>
								<span class="media-thumb">
									<img src={video.thumbnail} alt="" width="320" height="180" loading="lazy" />
									<svg class="play-badge" width="28" height="20" viewBox="0 0 20 14" aria-hidden="true"><rect width="20" height="14" rx="4" fill="#ff0033" /><path d="M8 4v6l5-3z" fill="#fff" /></svg>
								</span>
								<span class="media-title">{video.title}</span>
								<span class="media-meta">
									{video.viewsLabel && `${video.viewsLabel} views`}
									{videoDates.has(video.id) && ` · ${postedDate.format(new Date(videoDates.get(video.id)!))}`}
								</span>
							</a>
						</li>
					))}
				</ul>
			</section>

			<!-- Design: earlier design work from Behance. -->
			<section class="home-section" id="design">
				<div class="section-header">
					<h2>Design</h2>
					<a href="https://www.behance.net/steveharrison" target="_blank" class="view-all">Behance <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8l4 4-4 4"/><path d="M8 12h8"/></svg></a>
				</div>
				<ul class="media-grid design-grid">
					{designs.map((design) => (
						<li>
							<a class="media-card" href={design.behance} target="_blank" rel="noopener noreferrer" data-lightbox={`design-${design.slug}`}>
								<span class:list={['media-thumb', 'design-thumb', design.thumbFit && `fit-${design.thumbFit}`]}>
									<img src={design.images[0].src} alt="" loading="lazy" />
								</span>
								<span class="media-title">{design.title}</span>
								<span class="media-meta">{design.year}</span>
							</a>
						</li>
					))}
				</ul>
			</section>

			<section class="favourites">
				<Favourites />
			</section>
		</main>
		<Footer />

		<Lightbox />

		<script>
			// Career header videos play muted while on screen, unless motion is reduced.
			if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
				const observer = new IntersectionObserver((entries) => {
					for (const entry of entries) {
						const video = entry.target as HTMLVideoElement;
						if (entry.isIntersecting) video.play().catch(() => {});
						else video.pause();
					}
				}, { threshold: 0.4 });
				document.querySelectorAll('video[data-inview-play]').forEach((video) => observer.observe(video));
			}
		</script>

		<!-- Lightbox content: each hidden block is moved into the lightbox while its item is open. -->
		{projects.map((project) => (
			<div hidden class="lb-source" id={`lb-app-${project.slug}`}><ProjectDetail project={project} /></div>
		))}

		{videos.map((video) => (
			<div hidden class="lb-source" id={`lb-video-${video.id}`}>
				<div class="lb">
					<p class="lb-eyebrow">Video</p>
					<h2 id={`lb-title-video-${video.id}`}>{video.title}</h2>
					{video.viewsLabel && <p class="lb-meta">{video.viewsLabel} views on YouTube</p>}
					<div class="lb-embed">
						<iframe data-src={`https://www.youtube-nocookie.com/embed/${video.id}?autoplay=1&rel=0`} title={video.title} allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>
					</div>
					<p class="lb-links"><a href={video.href} target="_blank" rel="noopener noreferrer">Watch on YouTube →</a></p>
				</div>
			</div>
		))}

		{contributions.map((contribution, i) => !contribution.posts && (
			<div hidden class="lb-source" id={`lb-oss-${i}`}>
				<div class="lb">
					<p class="lb-project">
						{projectIcons[contribution.project] && <img src={projectIcons[contribution.project]} alt="" width="18" height="18" />}
						{contribution.project}
					</p>
					<h2 id={`lb-title-oss-${i}`}>{contribution.title}</h2>
					<p class="lb-meta">
						{contribution.merged ? <>Merged <time datetime={contribution.merged}>{postedAt.format(new Date(contribution.merged))}</time></> : contribution.date}
					</p>
					<p><Markdown text={contribution.description} /></p>
					{contribution.media && (
						<div class="pr-media">
							{contribution.media.map((item) => (
								<figure>
									{item.video ? (
										<video src={item.src} muted loop playsinline data-autoplay preload="none" aria-label={`${item.label}: ${contribution.title}`}></video>
									) : (
										<img src={item.src} alt={`${item.label}: ${contribution.title}`} loading="lazy" />
									)}
									<figcaption>{item.label}</figcaption>
								</figure>
							))}
						</div>
					)}
					{contribution.diff && (
						<div class="lb-diff">
							<Code {...parseDiff(contribution.diff, contribution.lang!)} lang={contribution.lang} wrap />
							{contribution.note && (
								<span class="cheeky-note">
									<svg width="44" height="22" viewBox="0 0 44 22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M42 6c-9-4-22-4-34 7" /><path d="M7 19.5 7.5 12.5 14 12" /></svg>
									{contribution.note}
								</span>
							)}
						</div>
					)}
					<p class="lb-links">
						<a href={contribution.href} target="_blank" rel="noopener noreferrer">View the pull request →</a>
					</p>
				</div>
			</div>
		))}

		{talks.map((talk, i) => (
			<div hidden class="lb-source" id={`lb-talk-${i}`}>
				<div class="lb">
					<p class="lb-eyebrow">Talk</p>
					<h2 id={`lb-title-talk-${i}`}>{talk.title}</h2>
					{talk.event && <p class="lb-meta">{talk.event}{talk.alsoGiven && <> · {talk.alsoGiven.event}</>}</p>}
					{talk.youtubeId && (
						<div class="lb-embed">
							<iframe data-src={`https://www.youtube-nocookie.com/embed/${talk.youtubeId}?start=613&autoplay=1&rel=0`} title={talk.title} allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>
						</div>
					)}
					{talk.image && !talk.deck && <img class="lb-image" src={talk.image} alt={talk.image.includes('2022-temporal') ? `On stage at ${talk.event}` : `Title slide of ${talk.title}`} loading="lazy" />}
					{talk.photo && <img class="lb-image" src={talk.photo} alt={`On stage at ${talk.event}, beside the “What's wrong with Date?” slide`} width="1280" height="720" loading="lazy" />}
					{talk.deck && <SlideViewer {...talk.deck} title={talk.title} />}
					{(talk.youtubeId || talk.repo || (talk.href && talk.href !== talk.deck?.pdf)) && (
						<p class="lb-links">
							{talk.youtubeId && <a href={talk.href} target="_blank" rel="noopener noreferrer">Watch on YouTube →</a>}
							{talk.href && !talk.youtubeId && talk.href !== talk.deck?.pdf && <a href={talk.href} target="_blank" rel="noopener noreferrer">{talk.href.startsWith('/') ? 'Read the write-up →' : 'More about the talk →'}</a>}
							{talk.alsoGiven && <a href={talk.alsoGiven.pdf} target="_blank" rel="noopener noreferrer">{talk.alsoGiven.event} slides (PDF) →</a>}
							{talk.repo && <a href={talk.repo} target="_blank" rel="noopener noreferrer">Code on GitHub →</a>}
						</p>
					)}
				</div>
			</div>
		))}

		{designs.map((design) => (
			<div hidden class="lb-source" id={`lb-design-${design.slug}`}>
				<div class="lb">
					<p class="lb-eyebrow">Design · {design.year}</p>
					<h2 id={`lb-title-design-${design.slug}`}>{design.title}</h2>
					<p>{design.description}</p>
					<div class="lb-stack">
						{design.images.map((image) => <img src={image.src} alt={image.alt} loading="lazy" />)}
					</div>
					<p class="lb-links"><a href={design.behance} target="_blank" rel="noopener noreferrer">View on Behance →</a></p>
				</div>
			</div>
		))}

		{career.filter((role) => role.inline).flatMap((role) => (role.media ?? []).map((item, i) => (
			<div hidden class="lb-source" id={`lb-shot-${role.slug}-${i}`}>
				<figure class="lb-shot">
					{item.video ? (
						<video src={item.src} poster={item.poster} controls playsinline muted loop data-autoplay preload="none" aria-label={item.alt}></video>
					) : (
						<img src={item.src} alt={item.alt} />
					)}
					<figcaption id={`lb-title-shot-${role.slug}-${i}`}>{item.alt}</figcaption>
				</figure>
			</div>
		)))}

		{career.map((role) => (
			<div hidden class="lb-source" id={`lb-role-${role.slug}`}>
				<div class="lb">
					<div class="lb-heading">
						{role.logo ? <img class="logo logo-large" src={role.logo} alt="" width="56" height="56" /> : <span class="logo logo-large logo-initials" aria-hidden="true">{role.initials}</span>}
						<div>
							<h2 id={`lb-title-role-${role.slug}`}>{role.company}</h2>
							<p class="lb-meta">{role.terms}</p>
						</div>
					</div>
					{role.summary && <p><Markdown text={role.summary} /></p>}
					{role.highlights && <ul class="lb-highlights">{role.highlights.map((item) => <li><Markdown text={item} /></li>)}</ul>}
					{role.tech && (
						<ul class="lb-tech">
							{role.tech.map((id) => tech[id] && (
								<li><span><img src={tech[id].icon} alt="" width="16" height="16" />{tech[id].name}</span></li>
							))}
						</ul>
					)}
					{role.media && (
						<div class="lb-media">
							{role.media.map((item) => (
								<figure class:list={[item.fit && `fit-${item.fit}`]}>
									{item.video ? (
										<video src={item.src} poster={item.poster} controls playsinline preload="none" aria-label={item.alt}></video>
									) : (
										<img src={item.src} alt={item.alt} loading="lazy" />
									)}
									<figcaption>{item.alt}</figcaption>
								</figure>
							))}
						</div>
					)}
				</div>
			</div>
		))}
	</body>
</html>

<style>
	* {
		box-sizing: border-box;
	}

	main {
		width: auto;
		margin: 0 auto;
		padding: 1em;
		max-width: 960px;
	}

	.hero-text {
		min-width: 0;
		flex: 0 1 auto;
	}

	.hero-text h1,
	.bio {
		overflow-wrap: anywhere;
	}

	/* Hero */
	.hero {
		display: flex;
		align-items: flex-start;
		justify-content: center;
		gap: 2.75em;
		padding: 3em 0;
		margin-bottom: 2.5em;
	}

	.print {
		position: relative;
		flex-shrink: 0;
		margin: 0;
		transform: rotate(-3deg);
		transition: transform 400ms var(--ease-out);
	}

	/* Nudge the print a little straighter, as if picked up off the desk. */
	@media (hover: hover) and (pointer: fine) {
		.print:hover {
			transform: rotate(-1.5deg) translateY(-2px);
		}
	}

	/* On load the print settles into place and the copy follows, a beat apart.
	   "backwards" (not "both") hands the transform back to .print afterwards, so the
	   hover above still works. */
	@media (prefers-reduced-motion: no-preference) {
		.print {
			animation: print-settle 700ms var(--ease-out) backwards;
		}

		.hero-text > * {
			animation: hero-rise 600ms var(--ease-out) backwards;
		}

		.hero-text > :nth-child(1) { animation-delay: 80ms; }
		.hero-text > :nth-child(2) { animation-delay: 140ms; }
		.hero-text > :nth-child(3) { animation-delay: 200ms; }
	}

	@media (prefers-reduced-motion: reduce) {
		.print,
		.hero-text > * {
			animation: hero-fade 300ms ease backwards;
		}

		.print {
			transition: none;
		}
	}

	@keyframes print-settle {
		from {
			opacity: 0;
			transform: translateY(8px) rotate(-7deg) scale(0.96);
		}
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
	}

	@keyframes hero-fade {
		from {
			opacity: 0;
		}
	}

	/* The paper sits on its own layer so the curl shadows stay underneath it. */
	.print-paper {
		position: relative;
		z-index: 1;
		display: block;
		padding: 8px 8px 22px;
		background: #fff;
		box-shadow:
			0 0 1px rgba(20, 20, 20, 0.18),
			0 1px 3px rgba(20, 20, 20, 0.1);
	}

	/* Lifted-corner shadows: two angled shadows tucked under the bottom corners. */
	.print::before,
	.print::after {
		content: '';
		position: absolute;
		bottom: 12px;
		width: 46%;
		height: 30%;
		box-shadow: 0 14px 12px rgba(20, 20, 20, 0.28);
		z-index: 0;
	}

	.print::before {
		left: 6px;
		transform: rotate(-4deg);
	}

	.print::after {
		right: 6px;
		transform: rotate(4deg);
	}

	.hero-avatar {
		display: block;
		width: 150px;
		height: 150px;
		object-fit: cover;
	}

	.paperclip {
		position: absolute;
		z-index: 2;
		top: -24px;
		left: 26px;
		transform: rotate(6deg);
		filter: drop-shadow(1px 2px 1.5px rgba(20, 20, 20, 0.25));
	}

	/* Type scale after apple.com: a large, tightly tracked headline, a 21px intro
	   line in near-black, then 17px body copy in a secondary grey. */
	.hero-text h1 {
		font-size: 48px;
		font-weight: 500;
		line-height: 1.08;
		letter-spacing: -0.003em;
		margin: 0 0 0.3em 0;
		color: #1d1d1f;
		text-wrap: balance;
	}

	.bio {
		max-width: 60ch;
		margin: 0;
		font-size: 17px;
		line-height: 1.47;
		letter-spacing: -0.022em;
		color: #6e6e73;
		text-wrap: pretty;
	}

	.bio-lead {
		margin-bottom: 0.65em;
		font-size: 21px;
		line-height: 1.38;
		letter-spacing: 0.011em;
		color: #1d1d1f;
	}

	/* Keep each icon on the same line as its name. */
	/* Black, medium-weight links (as in blog posts) without an underline;
	   the icons already mark them out. */
	.bio a {
		color: #000;
		font-weight: 500;
		text-decoration: none;
		transition: color 150ms ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.bio a:hover {
			color: rgb(102 102 102);
		}
	}

	.bio-link {
		white-space: nowrap;
	}

	/* Stack Overflow reputation chip, in the same family as the Hacker News badge. */
	/* Neutral chips in the intro that open a talk or pull request in the lightbox. */
	.bio a.intro-chip {
		display: inline-flex;
		align-items: baseline;
		gap: 0.35em;
		margin: 0 0.1em;
		padding: 0.05em 0.55em 0.05em 0.45em;
		border: 1px solid #e3e3e8;
		border-radius: 999px;
		background: #f7f7f9;
		color: #1d1d1f;
		font-size: 0.8em;
		font-weight: 600;
		letter-spacing: 0;
		vertical-align: 0.08em;
		white-space: nowrap;
		transition: background 0.15s ease, border-color 0.15s ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.bio a.intro-chip:hover {
			border-color: #d2d2d7;
			background: #efeff2;
			color: #1d1d1f;
		}
	}

	.bio a.so-chip {
		display: inline-flex;
		align-items: baseline;
		gap: 0.3em;
		margin: 0 0.1em;
		padding: 0.05em 0.5em;
		border: 1px solid #fbd9b8;
		border-radius: 999px;
		background: #fff7ef;
		color: #b85b00;
		font-size: 0.8em;
		font-weight: 600;
		letter-spacing: 0;
		vertical-align: 0.08em;
		white-space: nowrap;
		transition: background-color 150ms ease, transform 160ms var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.bio a.so-chip:hover {
			background: #ffeedd;
			color: #b85b00;
		}
	}

	.bio a.so-chip:active {
		transform: scale(0.97);
	}

	.so-chip svg {
		color: #f48024;
	}

	/* Baseline-align the chip text so the chip's baseline comes from its label,
	   not from the leading icon (whose baseline is its bottom edge, which lifted
	   the chip above the surrounding text). The icon stays vertically centred. */
	.bio a.intro-chip svg,
	.bio a.so-chip svg {
		align-self: center;
	}

	.so-unit {
		font-weight: 500;
	}

	/* Project names in the intro get their logo, like the Qantas and Finances App links. */
	.bio-term {
		white-space: nowrap;
	}

	.bio-icon {
		width: 1em;
		height: 1em;
		margin-right: 0.25em;
		vertical-align: -0.12em;
	}

	.bio-link img {
		width: 1.15em;
		height: 1.15em;
		margin-right: 0.25em;
		vertical-align: -0.2em;
		border-radius: 4px;
	}

	.bio-link img.bio-link-icon-qantas {
		margin-right: 1px;
	}

	.bio-link img.bio-link-icon-finances {
		margin-right: 4px;
	}

	/* Section headers */
	.section-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
		margin-bottom: 1em;
	}

	.section-header h2 {
		font-size: 1.4em;
		font-weight: 500;
		margin: 0;
		border: none;
		padding: 0;
		white-space: nowrap;
	}

	.view-all {
		display: flex;
		align-items: center;
		gap: 0.4em;
		font-size: 0.9em;
		font-weight: 500;
		color: #6e6e73;
		text-decoration: none;
		transition: color 150ms ease, transform 160ms var(--ease-out);
		white-space: nowrap;
		flex-shrink: 0;
	}

	.view-all svg {
		transition: transform 200ms var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.view-all:hover {
			color: #1d1d1f;
		}

		.view-all:hover svg {
			transform: translateX(2px);
		}
	}

	.view-all:active {
		transform: scale(0.97);
	}

	/* List sections (Articles / Videos) */
	.list-section {
		min-width: 0;
		margin-bottom: 0;
	}

	.item-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	/* Hacker News / X badges sit under the post's link (not inside it, since it's a
	   link of its own), lined up with the text rather than the icon. */
	.item-list li.has-badge {
		padding-bottom: 0.85em;
	}

	.item-list li.has-badge > a {
		padding-bottom: 0.4em;
	}

	.badges {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
		margin-left: calc(21px + 1.5em);
	}

	.item-list a {
		display: flex;
		align-items: center;
		gap: 1em;
		padding: 0.85em 0.5em;
		text-decoration: none;
		color: inherit;
		transition: background-color 150ms ease;
		border-radius: 6px;
	}

	/* A soft tint on hover, a touch darker while pressed. Rows are too wide to
	   scale on press without looking like they're jumping. */
	@media (hover: hover) and (pointer: fine) {
		.item-list a:hover {
			background: rgb(0 0 0 / 0.04);
		}
	}

	.item-list a:active {
		background: rgb(0 0 0 / 0.06);
	}

	.item-icon {
		flex-shrink: 0;
		color: #86868b;
	}

	.video-thumb {
		flex-shrink: 0;
		width: 72px;
		height: 40px;
		object-fit: cover;
		border-radius: 4px;
		/* Layered "plate" shadow after glenn.me, scaled down for a small thumbnail. */
		box-shadow:
			0 0 1px rgba(20, 20, 20, 0.15),
			0 1px 2px rgba(20, 20, 20, 0.1),
			0 3px 6px -1px rgba(20, 20, 20, 0.1),
			0 6px 12px -4px rgba(20, 20, 20, 0.12),
			0 12px 20px -8px rgba(20, 20, 20, 0.14);
	}

	.item-content {
		display: flex;
		flex-direction: column;
		flex: 1;
		min-width: 0;
	}

	.item-main {
		display: flex;
		justify-content: space-between;
		align-items: center;
		min-width: 0;
		gap: 1em;
	}

	.item-description {
		font-size: 0.82em;
		color: #6e6e73;
		margin-top: 0.2em;
		line-height: 1.4;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.item-title {
		font-weight: 500;
		font-size: 0.95em;
		color: #1d1d1f;
		min-width: 0;
		word-wrap: break-word;
		overflow-wrap: anywhere;
	}

	.item-date {
		font-size: 0.82em;
		color: #6e6e73;
		font-variant-numeric: tabular-nums;
		flex-shrink: 0;
		margin-left: 1em;
	}

	/* A hand-scrawled aside under the React diff, its arrow pointing back up at it. */
	.cheeky-note {
		display: flex;
		align-items: flex-start;
		gap: 0.2em;
		margin: 0.25em 0 0 1.5em;
		color: #d1342f;
		font-family: 'Comic Sans MS', 'Comic Neue', 'Chalkboard SE', cursive;
		font-size: 1.1em;
		transform: rotate(-2deg);
		transform-origin: left center;
	}

	.cheeky-note svg {
		flex-shrink: 0;
		margin-top: -0.3em;
	}

	/* Before/after screenshots and repro clips, indented under the PR's text. */
	.pr-media {
		display: flex;
		flex-wrap: wrap;
		gap: 1em;
		margin: 1.25em 0;
	}

	.pr-media figure {
		margin: 0;
	}

	.pr-media img,
	.pr-media video {
		display: block;
		height: 120px;
		width: auto;
		max-width: 100%;
		border-radius: 6px;
		box-shadow:
			0 0 1px rgba(20, 20, 20, 0.2),
			0 1px 2px rgba(20, 20, 20, 0.1),
			0 4px 8px -2px rgba(20, 20, 20, 0.12);
	}

	/* "Before", "After" and "Repro" as plain labels under each screenshot. */
	.pr-media figcaption {
		margin-top: 0.4em;
		color: var(--grey);
		font-size: 0.8em;
		font-weight: 500;
	}

	/* Open source: a small heading per project, with its contributions as cards. */
	.oss-group + .oss-group {
		margin-top: 1.5em;
	}

	/* Two cards per row; a project's only contribution takes the full width. */
	.oss-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.9em;
	}

	.oss-list > li.card {
		margin: 0;
		transition: transform 0.25s var(--ease-out, ease), box-shadow 0.25s ease;
	}

	/* Cards lift with a deeper shadow on hover, rather than tinting the row. */
	@media (hover: hover) and (pointer: fine) {
		.oss-list > li.card:hover {
			transform: translateY(-2px);
			box-shadow:
				0 0 0 1px rgba(20, 20, 20, 0.06),
				0 2px 4px rgba(20, 20, 20, 0.07),
				0 14px 30px -10px rgba(20, 20, 20, 0.26);
		}

		.oss-list > li.card > a:hover {
			background: none;
		}
	}

	.oss-list > li.card > a:active {
		background: none;
	}

	.oss-list > li:only-child {
		grid-column: 1 / -1;
	}

	/* Keyboard focus rings the whole card along its rounded edge, not the link inset
	   inside it. */
	.item-list > li.card:has(> a:focus-visible) {
		outline: 2px solid var(--focus-ring);
		outline-offset: 2px;
	}

	.item-list > li.card > a:focus-visible {
		outline: none;
	}

	@media (max-width: 760px) {
		.oss-list {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.oss-heading {
		display: flex;
		align-items: center;
		gap: 0.45em;
		margin: 0 0 0.5em 0.25em;
		color: #6e6e73;
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.01em;
	}

	.oss-heading img {
		width: 15px;
		height: 15px;
	}

	/* Top Stack Overflow posts as chips under the Stack Overflow entry, lined up with its text. */
	.so-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45em;
		margin: -0.25em 0.5em 0.9em;
		padding: 0;
		list-style: none;
	}

	.item-list .so-chips li {
		max-width: 100%;
		border: none;
	}

	.item-list .so-chips a {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		max-width: 100%;
		padding: 0.25em 0.75em 0.25em 0.3em;
		border: 1px solid #ececee;
		border-radius: 999px;
		background: #fff;
		color: #1d1d1f;
		font-size: 0.78em;
		text-decoration: none;
		transition: border-color 0.15s ease, background 0.15s ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.item-list .so-chips a:hover {
			border-color: #fbd9b8;
			background: #fffaf5;
		}
	}

	.so-chip-score {
		flex-shrink: 0;
		padding: 0.1em 0.55em;
		border-radius: 999px;
		background: #fff1e3;
		color: #b85b00;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}

	.so-chip-title {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-weight: 500;
	}

	.so-chip-date {
		flex-shrink: 0;
		font-size: inherit;
		color: #86868b;
		font-variant-numeric: tabular-nums;
	}

	/* Recorded talks show their video thumbnail with a small YouTube play badge. */
	.talk-recording {
		position: relative;
		flex-shrink: 0;
		display: block;
	}

	.talk-recording .video-thumb {
		display: block;
	}

	/* Talks without a picture get a tile the same size as a thumbnail, so titles line up. */
	.talk-tile {
		flex-shrink: 0;
		display: grid;
		place-items: center;
		width: 72px;
		height: 40px;
		border-radius: 4px;
		background: #f5f5f7;
		color: #86868b;
	}

	.play-badge {
		position: absolute;
		left: 50%;
		top: 50%;
		transform: translate(-50%, -50%);
		filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.35));
	}

	/* A talk without a link gets the same layout as the linked rows. */
	.item-static {
		display: flex;
		align-items: center;
		gap: 1em;
		padding: 0.85em 0.5em;
	}

	/* Apps: a springboard of app icons. */
	.apps-section {
		margin-bottom: 3em;
	}

	.app-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
		gap: 1em;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.app-tile {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.3em;
		width: 100%;
		padding: 1em 0.5em;
		border: none;
		border-radius: 18px;
		background: none;
		color: inherit;
		font: inherit;
		text-align: center;
		cursor: pointer;
		transition: background 0.15s ease;
	}

	.app-icon {
		width: 72px;
		height: 72px;
		margin-bottom: 0.35em;
		/* Each project's own icon, as drawn: no added tile, corners or shadow. */
		object-fit: contain;
		transition: transform 0.25s var(--ease-out, ease);
	}

	/* Follows the icon's own shape, so rounded and irregular icons get a natural shadow. */
	.app-icon.has-shadow {
		filter:
			drop-shadow(0 1px 1px rgba(20, 20, 20, 0.18))
			drop-shadow(0 6px 10px rgba(20, 20, 20, 0.2));
	}

	.app-name {
		font-size: 0.9em;
		font-weight: 600;
		color: #1d1d1f;
	}

	.app-years {
		font-size: 0.75em;
		color: #86868b;
	}

	@media (hover: hover) and (pointer: fine) {
		.app-tile:hover {
			background: rgba(0, 0, 0, 0.035);
		}

		.app-tile:hover .app-icon {
			transform: translateY(-3px) scale(1.04);
		}
	}

	.app-tile:active .app-icon {
		transform: scale(0.96);
	}

	.home-section {
		margin-bottom: 3.5em;
	}

	/* Videos and talks: cards with a 16:9 picture on top. */
	.media-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
		gap: 1.5em 1.25em;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.media-card {
		display: flex;
		flex-direction: column;
		gap: 0.3em;
		width: 100%;
		padding: 0;
		border: none;
		background: none;
		color: inherit;
		font: inherit;
		text-align: left;
		text-decoration: none;
		cursor: pointer;
	}

	.media-thumb {
		position: relative;
		display: grid;
		place-items: center;
		aspect-ratio: 16 / 9;
		margin-bottom: 0.5em;
		border-radius: 14px;
		overflow: hidden;
		background: #f5f5f7;
		color: #a1a1a6;
		box-shadow:
			0 0 2px rgba(20, 20, 20, 0.15),
			0 1px 2px rgba(20, 20, 20, 0.1),
			0 4px 8px -2px rgba(20, 20, 20, 0.1),
			0 10px 18px -6px rgba(20, 20, 20, 0.12);
		transition: transform 0.25s var(--ease-out, ease);
	}

	/* A talk or design's card is its rounded thumbnail, so keyboard focus rings that. */
	.media-card:focus-visible {
		outline: none;
	}

	.media-card:focus-visible .media-thumb {
		outline: 2px solid var(--focus-ring);
		outline-offset: 2px;
	}

	.media-thumb img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Talks without a photo: the event name on a soft gradient. */
	.media-thumb-empty {
		background: linear-gradient(150deg, #f5f5f7, #e8e8ed);
	}

	.talk-placeholder {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5em;
		color: #86868b;
	}

	.talk-placeholder span {
		color: #424245;
		font-size: 1.15em;
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.media-thumb .play-badge {
		position: absolute;
		left: 50%;
		top: 50%;
		transform: translate(-50%, -50%);
		filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.35));
	}

	@media (hover: hover) and (pointer: fine) {
		.media-card:hover .media-thumb {
			transform: translateY(-2px) scale(1.01);
		}
	}

	.media-title {
		font-weight: 600;
		line-height: 1.3;
		color: #1d1d1f;
	}

	.media-meta {
		color: #86868b;
		font-size: 0.82em;
	}

	/* Career: the current and featured roles in full on the timeline, the rest compact. */
	.current-role {
		padding: 1.75em 2em 1.5em;
		border-radius: 20px;
		background: #fff;
		box-shadow:
			0 0 0 1px rgba(20, 20, 20, 0.06),
			0 1px 2px rgba(20, 20, 20, 0.06),
			0 8px 22px -8px rgba(20, 20, 20, 0.16);
	}

	/* Type matches the compact cards: name at body size, terms small and grey, and the
	   summary and highlights at the same size as a compact card's summary. */
	.current-role .lb-meta {
		margin: 0.1em 0 0;
		color: #6e6e73;
		font-size: 0.85em;
	}

	.current-role h3 {
		margin: 0;
		font-size: 1em;
		font-weight: 600;
		line-height: 1.3;
	}

	.current-role .logo-large {
		width: 40px;
		height: 40px;
		border-radius: 10px;
		font-size: 1em;
	}

	.current-role .lb-heading {
		gap: 0.75em;
	}

	.current-role p,
	.current-role .lb-highlights {
		color: #424245;
		font-size: 0.88em;
		line-height: 1.55;
	}

	/* Open source contributions sit on white cards. */
	.item-list > li.card {
		margin: 0.6em 0;
		padding: 0.15em 0.35em;
		border: 4px solid #fff;
		border-radius: 14px;
		background: #fff;
		box-shadow:
			0 0 0 1px rgba(20, 20, 20, 0.06),
			0 1px 2px rgba(20, 20, 20, 0.06),
			0 6px 16px -6px rgba(20, 20, 20, 0.14);
	}

	/* Career timeline: the start years on a timescale down the left, and a rail with a
	   dot beside each role's card. */
	.timeline {
		--tl-year: 3.25rem;
		--tl-rail: 2.25rem;
		--tl-x: calc(var(--tl-year) + var(--tl-rail) / 2);
		--tl-dot: 12px;
		--tl-top: 2px;
		position: relative;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* The rail: a segment from each role's dot down to the next one's, so it starts at
	   the newest role and stops cleanly at the earliest. */
	.tl-item:not(:last-child)::after {
		content: '';
		position: absolute;
