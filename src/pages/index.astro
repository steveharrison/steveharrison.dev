---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import Lightbox from '../components/Lightbox.astro';
import ProjectDetail from '../components/ProjectDetail.astro';
import Favourites from '../components/Favourites.astro';
import { Code } from 'astro-expressive-code/components';
import SlideViewer from '../components/SlideViewer.astro';
import ArticleGrid from '../components/ArticleGrid.astro';
import Markdown from '../components/Markdown.astro';
import { visibleProjects as projects, career, tech, visibleDesigns as designs } from '../data/portfolio';
import { byPopularity } from '../lib/popularity';
import StackOverflowIcon from '../assets/icons/stackoverflow.svg';
import sharp from 'sharp';

const posts = (await getCollection('blog')).sort(byPopularity).slice(0, 3);

// Each inline role thumbnail's width / height, so a row of them can share one height.
const thumbAspect = new Map<string, number>();
for (const item of career.flatMap((role) => (role.inline && role.media) || [])) {
	const src = item.video ? item.poster : item.src;
	if (!src || thumbAspect.has(src)) continue;
	try {
		const { width, height } = await sharp(`${process.cwd()}/public${src}`).metadata();
		if (width && height) thumbAspect.set(src, width / height);
	} catch (e) {
		console.warn(`Failed to read thumbnail size for ${src}:`, e);
	}
}


// Stack Overflow reputation, fetched at build time (falls back to the last known figure).
let stackOverflowReputation = 126498;
try {
	const res = await fetch('https://api.stackexchange.com/2.3/users/48492?site=stackoverflow');
	const reputation = (await res.json()).items?.[0]?.reputation;
	if (typeof reputation === 'number') stackOverflowReputation = reputation;
} catch (e) {
	console.warn('Failed to fetch Stack Overflow reputation:', e);
}
// e.g. "22 Jun 2009, 6:30 pm AEST", in Sydney time. The date comes from en-GB because
// en-AU writes "June"/"July" in full but abbreviates the other months.
const postedDate = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Australia/Sydney' });
const postedTime = new Intl.DateTimeFormat('en-AU', { hour: 'numeric', minute: '2-digit', timeZone: 'Australia/Sydney', timeZoneName: 'short' });
const postedAt = { format: (date: Date) => `${postedDate.format(date)}, ${postedTime.format(date)}` };
const reputationLabel = new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 }).format(stackOverflowReputation);

// Fetch videos from YouTube at build time and show the most viewed.
const YOUTUBE_CHANNEL_URL = 'https://www.youtube.com/@steve_harrison/videos';
let videos: { id: string; title: string; thumbnail: string; href: string; views: number; viewsLabel: string }[] = [];

// YouTube abbreviates counts on the channel page ("2.9K", "1.2M"); good enough to rank by.
function parseViews(text: string | undefined): number {
	const m = text?.replace(/,/g, '').match(/([\d.]+)\s*([KMB])?/i);
	if (!m) return 0;
	const scale = { K: 1e3, M: 1e6, B: 1e9 }[m[2]?.toUpperCase() as 'K' | 'M' | 'B'] ?? 1;
	return Math.round(parseFloat(m[1]) * scale);
}

try {
	const res = await fetch(YOUTUBE_CHANNEL_URL);
	const html = await res.text();
	const match = html.match(/var ytInitialData = ({.*?});<\/script>/);
	if (match) {
		const data = JSON.parse(match[1]);
		const tabs = data.contents.twoColumnBrowseResultsRenderer.tabs;
		for (const tab of tabs) {
			if (tab.tabRenderer?.title === 'Videos') {
				const items = tab.tabRenderer.content.richGridRenderer.contents;
				for (const item of items) {
					const content = item.richItemRenderer?.content;
					if (!content) continue;

					// Newer YouTube layout: lockupViewModel
					const lockup = content.lockupViewModel;
					if (lockup) {
						const videoId = lockup.contentId;
						const metadata = lockup.metadata?.lockupMetadataViewModel;
						const title = metadata?.title?.content;
						// The first metadata part is the view count, e.g. "2.9K".
						const viewsLabel = metadata?.metadata?.contentMetadataViewModel?.metadataRows?.[0]?.metadataParts?.[0]?.text?.content;
						if (videoId && title) {
							videos.push({
								id: videoId,
								title,
								thumbnail: `https://i.ytimg.com/vi/${videoId}/mqdefault.jpg`,
								href: `https://www.youtube.com/watch?v=${videoId}`,
								views: parseViews(viewsLabel),
								viewsLabel: viewsLabel ?? '',
							});
						}
						continue;
					}

					// Older YouTube layout: videoRenderer
					const vid = content.videoRenderer;
					if (vid) {
						const viewsLabel = vid.shortViewCountText?.simpleText?.replace(/\s*views?$/i, '');
						videos.push({
							id: vid.videoId,
							title: vid.title.runs[0].text,
							thumbnail: `https://i.ytimg.com/vi/${vid.videoId}/mqdefault.jpg`,
							href: `https://www.youtube.com/watch?v=${vid.videoId}`,
							views: parseViews(viewsLabel),
							viewsLabel: viewsLabel ?? '',
						});
					}
				}
				break;
			}
		}
	}
} catch (e) {
	console.warn('Failed to fetch YouTube videos:', e);
}
// Hand-picked, in order. If YouTube's page changes and a pick is missing, fall back to the most viewed.
const FEATURED_VIDEOS = ['s-yZMJ0cnig', 'otejcLXeHe0', 'AOzGRO9Iz_4']; // Xcode completion, JSON Crack, InstantDB
const byViews = videos.toSorted((a, b) => b.views - a.views);
videos = [
	...FEATURED_VIDEOS.map((id) => videos.find((video) => video.id === id)).filter((video) => video !== undefined),
	...byViews.filter((video) => !FEATURED_VIDEOS.includes(video.id)),
].slice(0, 3);

// The channel page only says "8mo ago", so read each top video's publish date from its page.
const videoDates = new Map<string, string>();
await Promise.all(
	videos.map(async (video) => {
		try {
			const html = await (await fetch(video.href)).text();
			const date = html.match(/"uploadDate":"([^"]+)"/)?.[1];
			if (date) videoDates.set(video.id, date);
		} catch (e) {
			console.warn(`Failed to fetch the publish date for ${video.href}:`, e);
		}
	}),
);

