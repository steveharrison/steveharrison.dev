---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Favourites from '../components/Favourites.astro';
import { SITE_TITLE } from '../consts';

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Recommendations | ${SITE_TITLE}`} description="Books I've enjoyed and apps I use every day." />
	</head>
	<body>
		<Header />
		<main>
			<h1>Recommendations</h1>
			<p class="intro">Books I've enjoyed and apps I use every day.</p>

			<Favourites />
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		box-sizing: border-box;
		width: auto;
		max-width: 960px;
		margin: 0 auto;
		padding: 1em;
	}

	main > h1 {
		font-size: 2.2em;
		font-weight: 700;
		margin: 1em 0 0.2em;
	}

	.intro {
		color: var(--grey);
		margin: 0 0 2em;
	}

</style>
